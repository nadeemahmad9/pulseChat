
# ===================================
# SERVER / BACKEND CONFIGURATION
# ===================================
PORT=3002
NODE_ENV=development

# MongoDB Atlas Connection String (Replace with your credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pulsechat?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Client URL (For CORS & Socket allowed origins)
CLIENT_URL=http://localhost:5173

# ===================================
# CLIENT / FRONTEND CONFIGURATION (Vite)
# ===================================
VITE_API_URL=http://localhost:3002
VITE_SOCKET_URL=http://localhost:3002